    WHERE category_name IS NOT NULL
)

SELECT
    -- Surrogate key
    md5(category_name)      AS category_sk,

    -- Natural key
    category_name,

    -- Normalized label
    LOWER(category_name)    AS category_name_normalized

FROM stg
ORDER BY category_name
    );
  
  
